config_version=5

[application]

boot_splash/image="res://resource/splash/main.png"
config/icon="res://resource/app_icon/main.png"
config/name="패들 듀얼"
config/name_localized={
"ko": "패들 듀얼",
"en": "Paddle Duel"
}
run/main_scene="res://boot/boot.tscn"

[audio]

general/default_playback_type.web=0

[debug]

gdscript/warnings/inference_on_variant=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/untyped_declaration=2

[display]

window/handheld/orientation=4
window/size/viewport_height=1080
window/size/viewport_width=1920

[editor]

export/convert_text_resources_to_binary=false
import/use_multiple_threads=false

